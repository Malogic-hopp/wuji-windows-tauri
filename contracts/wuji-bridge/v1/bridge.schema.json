{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wuji/contracts/bridge/v1/bridge.schema.json",
  "title": "WUJI Client Bridge API v1",
  "type": "object",
  "x-wuji-api-version": "1.0",
  "x-wuji-methods": [
    "bridge.hello",
    "client.initialize",
    "agent.getStatus",
    "agent.start",
    "agent.pause",
    "agent.resume",
    "agent.stop",
    "activity.getOverview",
    "settings.get",
    "settings.update",
    "bridge.shutdown"
  ],
  "x-wuji-error-codes": [
    "parse_error",
    "invalid_request",
    "payload_too_large",
    "method_not_found",
    "handshake_required",
    "initialization_required",
    "unsupported_api_version",
    "request_timeout",
    "request_cancelled",
    "validation_failed",
    "internal_error"
  ],
  "$defs": {
    "BridgeErrorKind": {
      "type": "string",
      "enum": [
        "validation",
        "transient",
        "conflict",
        "not_found",
        "unsupported",
        "internal"
      ]
    },
    "BridgeRequestMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "correlationId"
      ],
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "correlationId": {
          "type": "string"
        }
      }
    },
    "BridgeRequestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params",
        "meta"
      ],
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "meta": {
          "$ref": "#/$defs/BridgeRequestMeta"
        }
      }
    },
    "BridgeErrorData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "retryable",
        "correlationId"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/BridgeErrorKind"
        },
        "retryable": {
          "type": "boolean"
        },
        "correlationId": {
          "type": "string"
        },
        "fieldErrors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SettingsFieldError"
          }
        }
      }
    },
    "BridgeError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "data"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/BridgeErrorData"
        }
      }
    },
    "BridgeResponseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id"
      ],
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "additionalProperties": true
        },
        "error": {
          "$ref": "#/$defs/BridgeError"
        }
      }
    },
    "BridgeHelloParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "BridgeHelloResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "bridgeVersion",
        "capabilities"
      ],
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "bridgeVersion": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ClientInitializeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ClientInitializeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "channelName",
        "productDisplayName",
        "isDefaultChannel",
        "capabilities"
      ],
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "channelName": {
          "type": "string"
        },
        "productDisplayName": {
          "type": "string"
        },
        "isDefaultChannel": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "BridgeShutdownParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "BridgeShutdownResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "AgentState": {
      "type": "string",
      "enum": [
        "not_running",
        "starting",
        "running",
        "pausing",
        "paused",
        "resuming",
        "stopping",
        "stopped",
        "stale",
        "error",
        "maintenance"
      ]
    },
    "AgentGetStatusParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "AgentStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actualState",
        "isRunning",
        "isHealthy",
        "isStale"
      ],
      "properties": {
        "actualState": {
          "$ref": "#/$defs/AgentState"
        },
        "isRunning": {
          "type": "boolean"
        },
        "isHealthy": {
          "type": "boolean"
        },
        "isStale": {
          "type": "boolean"
        },
        "lastHeartbeatUtc": {
          "type": "string"
        },
        "lastSampleUtc": {
          "type": "string"
        }
      }
    },
    "AgentStartParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "AgentPauseParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "AgentResumeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "AgentStopParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ActivityGetOverviewParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ActivityOverviewSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dateUtc",
        "totalDurationSeconds",
        "activeDurationSeconds",
        "idleDurationSeconds",
        "unknownDurationSeconds",
        "sessionCount"
      ],
      "properties": {
        "dateUtc": {
          "type": "string",
          "format": "date-time"
        },
        "totalDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "activeDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "idleDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "unknownDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "sessionCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ActivityOverviewApp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "totalDurationSeconds",
        "activeDurationSeconds",
        "idleDurationSeconds",
        "unknownDurationSeconds",
        "sessionCount"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 128
        },
        "totalDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "activeDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "idleDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "unknownDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "sessionCount": {
          "type": "integer",
          "minimum": 0
        },
        "lastUsedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ActivityOverviewSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "startedAtUtc",
        "totalDurationSeconds",
        "activeDurationSeconds",
        "idleDurationSeconds",
        "unknownDurationSeconds"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 128
        },
        "startedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "endedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "totalDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "activeDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "idleDurationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "unknownDurationSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ActivityOverviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "topApps",
        "recentSessions"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/ActivityOverviewSummary"
        },
        "topApps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityOverviewApp"
          }
        },
        "recentSessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityOverviewSession"
          }
        }
      }
    },
    "SettingsTheme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "high_contrast"
      ]
    },
    "SettingsAppSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "refreshIntervalSeconds",
        "autoStartAgentWhenAppStarts"
      ],
      "properties": {
        "theme": {
          "$ref": "#/$defs/SettingsTheme"
        },
        "refreshIntervalSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        },
        "autoStartAgentWhenAppStarts": {
          "type": "boolean"
        }
      }
    },
    "SettingsAgentOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samplingIntervalSeconds",
        "idleThresholdSeconds",
        "heartbeatIntervalSeconds",
        "staleThresholdSeconds",
        "retentionDays",
        "enableJsonlJournal",
        "enableAgentEventJournal",
        "enableSessionMerge",
        "maskWindowTitles"
      ],
      "properties": {
        "samplingIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "idleThresholdSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "heartbeatIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "staleThresholdSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "enableJsonlJournal": {
          "type": "boolean"
        },
        "enableAgentEventJournal": {
          "type": "boolean"
        },
        "enableSessionMerge": {
          "type": "boolean"
        },
        "maskWindowTitles": {
          "type": "boolean"
        }
      }
    },
    "SettingsSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appSettings",
        "agentOptions"
      ],
      "properties": {
        "appSettings": {
          "$ref": "#/$defs/SettingsAppSettings"
        },
        "agentOptions": {
          "$ref": "#/$defs/SettingsAgentOptions"
        }
      }
    },
    "SettingsGetParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "SettingsGetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings",
        "defaults"
      ],
      "properties": {
        "settings": {
          "$ref": "#/$defs/SettingsSnapshot"
        },
        "defaults": {
          "$ref": "#/$defs/SettingsSnapshot"
        }
      }
    },
    "SettingsUpdateParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings"
      ],
      "properties": {
        "settings": {
          "$ref": "#/$defs/SettingsSnapshot"
        }
      }
    },
    "SettingsUpdateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saved",
        "settings"
      ],
      "properties": {
        "saved": {
          "type": "boolean"
        },
        "settings": {
          "$ref": "#/$defs/SettingsSnapshot"
        }
      }
    },
    "SettingsFieldError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "message"
      ],
      "properties": {
        "field": {
          "type": "string",
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "CommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "completed",
        "actualState",
        "usedFallback"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        },
        "actualState": {
          "$ref": "#/$defs/AgentState"
        },
        "usedFallback": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "errorCode": {
          "type": "string"
        }
      }
    }
  }
}
