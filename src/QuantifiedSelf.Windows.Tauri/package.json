{
  "name": "@wuji/windows-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.14.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "vite",
    "bridge:prepare": "dotnet publish ../QuantifiedSelf.Windows.Client.Bridge/QuantifiedSelf.Windows.Client.Bridge.csproj -c Debug -r win-x64 --self-contained false -o ./src-tauri/sidecars/bridge",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle:check": "node ./scripts/check-bundle-budget.mjs",
    "smoke:bridge-recovery": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bridge-recovery-smoke.ps1",
    "smoke:dashboard-parity": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dashboard-parity-smoke.ps1",
    "smoke:lifecycle-parity": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/lifecycle-parity-smoke.ps1",
    "smoke:settings-parity": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/settings-parity-smoke.ps1",
    "soak:lifecycle": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/lifecycle-soak.ps1",
    "soak:lifecycle:24h": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/lifecycle-soak.ps1 -DurationMinutes 1440 -SampleIntervalSeconds 60 -WarmupMinutes 5 -AgentExpectation Running",
    "contracts:generate": "dotnet run --project ../../tools/QuantifiedSelf.Windows.Bridge.ContractGen -- --write --repo-root ../..",
    "contracts:check": "dotnet run --project ../../tools/QuantifiedSelf.Windows.Bridge.ContractGen -- --check --repo-root ../..",
    "tauri": "tauri"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.101.2",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
