{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "吾迹（开发预览）",
  "version": "0.1.0",
  "identifier": "com.wuji.windows.dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "吾迹 · 开发预览",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: asset:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "targets": "nsis"
  }
}
