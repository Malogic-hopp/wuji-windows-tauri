<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Navigation.xaml — WUJI 侧边栏导航样式
         侧边栏背景、导航按钮、选中态、Agent 状态区域。
         ============================================================ -->

    <!-- ── 侧边栏容器 ── -->
    <Style x:Key="ShellSidebarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ── 主导航按钮（侧边栏内） ── -->
    <Style x:Key="ShellNavButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ShellNavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ShellNavSelectedBorderBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 导航按钮（内嵌 DataTrigger 做选中态）─ 统一 Default/Hover/Selected/Focus ── -->
    <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellNavButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ShellNavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ShellNavSelectedBorderBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ShellNavSelectedBgBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ShellNavSelectedBorderBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 侧边栏分组标题（主导航 / 辅助入口） ── -->
    <Style x:Key="ShellSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="4,14,0,8" />
    </Style>

    <!-- ── 侧边栏小标题 ── -->
    <Style x:Key="ShellSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ── 侧边栏底部信息 ── -->
    <Style x:Key="ShellFooterBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ShellSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- ── 侧边栏 Agent 状态面板（保留样式但侧栏已不再使用） ── -->
    <Style x:Key="ShellStatusPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ShellSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- ── 顶部页面栏容器 ── -->
    <Style x:Key="TopBarBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="MinHeight" Value="56" />
    </Style>

    <!-- ── 内容区容器 ── -->
    <Style x:Key="ContentAreaBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

</ResourceDictionary>
