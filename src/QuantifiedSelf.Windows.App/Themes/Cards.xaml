<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         Cards.xaml — WUJI 卡片体系
         统一圆角、内边距、边框和阴影。
         ============================================================ -->

    <!-- Canonical dimension tokens -->
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>
    <CornerRadius x:Key="CellRadius">3</CornerRadius>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="EmptyStatePadding">40</Thickness>
    <Thickness x:Key="SurfaceInsetPadding">12</Thickness>
    <Thickness x:Key="CompactInsetPadding">10,8</Thickness>
    <Thickness x:Key="TimelineRowPadding">0,8,0,8</Thickness>
    <Thickness x:Key="SegmentedControlPadding">4</Thickness>
    <Thickness x:Key="CompactCardPadding">10</Thickness>

    <!-- ── 基础卡片（最常用） ── -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ── 指标卡片（紧凑、无阴影） ── -->
    <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>

    <!-- ── 内容卡片（带轻阴影，用于主内容区） ── -->
    <Style x:Key="ContentCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="24,20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="2"
                                  Opacity="0.04"
                                  Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 洞察/结论卡片（强调，带左侧 Accent 色条） ── -->
    <Style x:Key="InsightCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
        <Setter Property="Padding" Value="20" />
    </Style>


</ResourceDictionary>
