<Window x:Class="QuantifiedSelf.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:QuantifiedSelf.Windows.App.Converters"
        xmlns:views="clr-namespace:QuantifiedSelf.Windows.App.Views"
        mc:Ignorable="d"
        Title="WUJI 吾迹"
        Width="1280"
        Height="860"
        MinWidth="1100"
        MinHeight="760"
        Background="#F3F6FA">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#115E59" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="White" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FBFD" />
        <SolidColorBrush x:Key="TextBrush" Color="#102A43" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#52606D" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D9E2EC" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C5D3E8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                    <Setter Property="Background" Value="#E8ECF0" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" Color="#33000000" ShadowDepth="2" Opacity="0.12" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardTopCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="DashboardMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="DashboardMetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="DashboardInsightMetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F6FAFC" Offset="0" />
                <GradientStop Color="#EBF2F7" Offset="0.6" />
                <GradientStop Color="#E7EEF5" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Grid.Row="0" Background="#0F172A">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="WUJI" FontSize="28" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="吾迹" Margin="0,6,0,0" Foreground="#CBD5E1" FontSize="14" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#132238" CornerRadius="999" Padding="14,6" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding AgentStatusText}" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" Foreground="#CBD5E1" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Grid.Row="1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="Start Agent" Command="{Binding StartAgentCommand}" />
                        <Button Content="Stop Agent" Command="{Binding StopAgentCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Pause" Command="{Binding PauseCollectionCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Resume" Command="{Binding ResumeCollectionCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>

                    <Button Content="Open Settings" Command="{Binding OpenSettingsCommand}" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" />
                </DockPanel>
            </Border>

            <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                <TabItem Header="Dashboard">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: compact agent overview -->
                            <Border Style="{StaticResource CardBorderStyle}" Grid.Row="0" Padding="14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="2.1*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                        <TextBlock Text="Agent state" Style="{StaticResource DashboardMetricLabelStyle}" />
                                        <TextBlock Text="{Binding AgentStatusText}" Style="{StaticResource DashboardMetricValueStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                        <TextBlock Text="Last heartbeat" Style="{StaticResource DashboardMetricLabelStyle}" />
                                        <TextBlock Text="{Binding LastHeartbeatText}" Style="{StaticResource DashboardMetricValueStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,18,0">
                                        <TextBlock Text="Last sample" Style="{StaticResource DashboardMetricLabelStyle}" />
                                        <TextBlock Text="{Binding LastSampleText}" Style="{StaticResource DashboardMetricValueStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="0,0,18,0">
                                        <TextBlock Text="Today Active" Style="{StaticResource DashboardMetricLabelStyle}" />
                                        <TextBlock Text="{Binding DashboardViewModel.TotalActiveText}" Style="{StaticResource DashboardMetricValueStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Agent process" Style="{StaticResource DashboardMetricLabelStyle}" />
                                        <TextBlock Text="{Binding AgentProcessText}" Style="{StaticResource DashboardMetricValueStyle}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Row 1: Today Insight -->
                            <Border Style="{StaticResource CardBorderStyle}" Grid.Row="1" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Today Insight" FontSize="16" FontWeight="SemiBold" />

                                    <!-- Summary + metrics -->
                                    <Grid Margin="0,12,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.35*" />
                                            <ColumnDefinition Width="2.65*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,0,12,10">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DashboardViewModel.SummaryText}" FontSize="14"
                                                           TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Margin="0,8,0,0" FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}" Opacity="0.6">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="更新于 {0}">
                                                            <Binding Path="DashboardViewModel.GeneratedAtText" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <UniformGrid Grid.Column="1" Columns="3" Rows="2">
                                            <Border Style="{StaticResource DashboardInsightMetricCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Active" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding DashboardViewModel.TotalActiveText}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource DashboardInsightMetricCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Sessions" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding DashboardViewModel.SessionCountText}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource DashboardInsightMetricCardStyle}" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="Samples" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding DashboardViewModel.SampleCountText}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource DashboardInsightMetricCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Context Switches" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding DashboardViewModel.ContextSwitchText}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource DashboardInsightMetricCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Longest Focus" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding DashboardViewModel.LongestFocusText}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource DashboardInsightMetricCardStyle}" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="Time Range" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding DashboardViewModel.TimeRangeText}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </Grid>

                                    <!-- Suggestions -->
                                    <ItemsControl ItemsSource="{Binding DashboardViewModel.Suggestions}" Margin="0,0,0,14">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="14" Margin="0,0,0,8"
                                                        Background="{StaticResource SurfaceAltBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Severity indicator -->
                                                        <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                                VerticalAlignment="Stretch" Margin="0,0,12,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Positive">
                                                                            <Setter Property="Background" Value="#4CAF50" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                            <Setter Property="Background" Value="#FF9800" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Neutral">
                                                                            <Setter Property="Background" Value="#607D8B" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontSize="14"
                                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Message}" FontSize="13"
                                                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                                                       Foreground="{StaticResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding EvidenceText}" FontSize="12"
                                                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       Opacity="0.8" />
                                                            <TextBlock Text="{Binding ActionText}" FontSize="13"
                                                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                                                       FontStyle="Italic" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Activity Heatmap -->
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Activity Heatmap" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                                                       Foreground="{StaticResource MutedTextBrush}" />

                                            <!-- Column headers: date labels from ViewModel -->
                                            <Grid Margin="36,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding DashboardViewModel.Heatmap.DateLabels[0]}" />
                                                <TextBlock Grid.Column="1" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding DashboardViewModel.Heatmap.DateLabels[1]}" />
                                                <TextBlock Grid.Column="2" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding DashboardViewModel.Heatmap.DateLabels[2]}" />
                                                <TextBlock Grid.Column="3" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding DashboardViewModel.Heatmap.DateLabels[3]}" />
                                                <TextBlock Grid.Column="4" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding DashboardViewModel.Heatmap.DateLabels[4]}" />
                                                <TextBlock Grid.Column="5" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding DashboardViewModel.Heatmap.DateLabels[5]}" />
                                                <TextBlock Grid.Column="6" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding DashboardViewModel.Heatmap.DateLabels[6]}" />
                                            </Grid>

                                            <!-- Heatmap + hour labels: 24 rows × 7 columns -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Hour labels (left side) -->
                                                <ItemsControl Grid.Column="0" Margin="0,1,4,0"
                                                              ItemsSource="{Binding DashboardViewModel.Heatmap.HourLabels}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Height="18" FontSize="9"
                                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       Text="{Binding ., TargetNullValue=''}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Heatmap cells: 24 rows × 7 columns (hour-major) -->
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding DashboardViewModel.Heatmap.Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="7" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Height="18" CornerRadius="2" Margin="1"
                                                                    Background="{Binding Background}"
                                                                    ToolTip="{Binding TooltipText}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 7-Day Trend -->
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="7-Day Trend" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                                                       Foreground="{StaticResource MutedTextBrush}" />

                                            <!-- Seven-day bar chart -->
                                            <ItemsControl ItemsSource="{Binding DashboardViewModel.TrendDays}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="7" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="3,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="82" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Text="{Binding ActiveText}" Grid.Row="0" FontSize="11"
                                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       FontWeight="SemiBold" Margin="0,0,0,6" />

                                                            <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                                                <Border Background="#D9E2EC" Opacity="0.45"
                                                                        CornerRadius="6"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Bottom"
                                                                        Width="18"
                                                                        Height="72" />

                                                                <Border Width="18"
                                                                        Height="{Binding BarHeightPixels}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Bottom"
                                                                        CornerRadius="6">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#94A3B8" />
                                                                            <Setter Property="BorderBrush" Value="#94A3B8" />
                                                                            <Setter Property="BorderThickness" Value="0" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
                                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                            </Grid>

                                                            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding DayLabel}" FontSize="11"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding DateLabel}" FontSize="10"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Trend comparison -->
                                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13"
                                                       Foreground="{StaticResource MutedTextBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}&#x0a;{1}&#x0a;{2}&#x0a;{3}&#x0a;{4}">
                                                        <Binding Path="DashboardViewModel.ActiveTrendText" />
                                                        <Binding Path="DashboardViewModel.YesterdayActiveTrendText" />
                                                        <Binding Path="DashboardViewModel.WeekActiveTrendText" />
                                                        <Binding Path="DashboardViewModel.FocusTrendText" />
                                                        <Binding Path="DashboardViewModel.SwitchTrendText" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Top Apps + Top Windows -->
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="Top Apps" FontSize="16" FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding DashboardViewModel.TopApps}" Margin="0,12,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}">
                                                                        <TextBlock.Text>
                                                                            <MultiBinding StringFormat="Active {0}s / Total {1}s">
                                                                                <Binding Path="ActiveDurationSeconds" />
                                                                                <Binding Path="TotalDurationSeconds" />
                                                                            </MultiBinding>
                                                                        </TextBlock.Text>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Top Windows" FontSize="16" FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding DashboardViewModel.TopWindows}" Margin="0,12,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding SafeWindowTitle, TargetNullValue='(no title)', FallbackValue='(no title)'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}">
                                                                        <TextBlock.Text>
                                                                            <MultiBinding StringFormat="{}{0} · {1} samples">
                                                                                <Binding Path="ProcessName" />
                                                                                <Binding Path="SampleCount" />
                                                                            </MultiBinding>
                                                                        </TextBlock.Text>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Row 3: Messages -->
                            <Border Style="{StaticResource CardBorderStyle}" Grid.Row="2" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Messages" FontSize="16" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Messages}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Apps">
                    <views:AppsView DataContext="{Binding AppsViewModel}" />
                </TabItem>

                <TabItem Header="Sessions">
                    <views:SessionsView DataContext="{Binding SessionsViewModel}" />
                </TabItem>

                <TabItem Header="Samples">
                    <views:SamplesView DataContext="{Binding SamplesViewModel}" />
                </TabItem>

                <TabItem Header="Diagnostics">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Diagnostics Overview" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CurrentJournalPathText}" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CurrentSessionIdText, StringFormat=Current Session Id: {0}}" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding LastEventWriteErrorText, StringFormat=SQLite Last Error: {0}}" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LastJournalWriteErrorText, StringFormat=JSONL Last Error: {0}}" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding IpcStatusText}" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding RefreshHealthText}" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="SQLite write state" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding EventWriterStatusText}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="JSONL write state" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding JournalWriterStatusText}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Login Startup section (added in Phase 11.5) -->
                            <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,32,0">
                                        <TextBlock Text="Login startup" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LoginStartupStatusText}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,32,0">
                                        <TextBlock Text="Launch mode" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LaunchModeText}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Startup registration" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StartupRegistrationSummary}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding LastStartupRegistrationErrorText, StringFormat=Last error: {0}}" FontSize="14" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,16">
                                <StackPanel>
                                    <TextBlock Text="runtime_state.json" FontSize="16" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding RuntimeStateJson, Mode=OneWay}" Margin="0,12,0,0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap" MinHeight="280" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,16">
                                <StackPanel>
                                    <TextBlock Text="health_state.json" FontSize="16" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding HealthStateJson, Mode=OneWay}" Margin="0,12,0,0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap" MinHeight="280" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="agent_control.json" FontSize="16" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding ControlCommandJson, Mode=OneWay}" Margin="0,12,0,0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap" MinHeight="280" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="3" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="Recent Events" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="暂无最近事件。Agent 运行后，事件会显示在这里。" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding RecentEvents.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding RecentEvents}" Margin="0,12,0,0" Visibility="{Binding RecentEvents.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding EventTimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                            <TextBlock Margin="0,4,0,0">
                                                                <Run Text="{Binding EventType}" FontWeight="SemiBold" />
                                                                <Run Text=" · " />
                                                                <Run Text="{Binding EventLevel}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Message}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding ErrorCode, StringFormat=ErrorCode {0}}" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding ErrorCode, Converter={StaticResource StringToVisibilityConverter}}" />
                                                            <TextBlock Text="{Binding RequestId, StringFormat=RequestId {0}}" Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding RequestId, Converter={StaticResource StringToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Recent Errors" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="暂无告警或错误。出现 Warning / Error / Critical 事件后会显示在这里。" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding RecentErrors.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding RecentErrors}" Margin="0,12,0,0" Visibility="{Binding RecentErrors.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding EventTimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                            <TextBlock Margin="0,4,0,0">
                                                                <Run Text="{Binding EventType}" FontWeight="SemiBold" />
                                                                <Run Text=" · " />
                                                                <Run Text="{Binding EventLevel}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Message}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding ErrorCode, StringFormat=ErrorCode {0}}" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding ErrorCode, Converter={StaticResource StringToVisibilityConverter}}" />
                                                            <TextBlock Text="{Binding RequestId, StringFormat=RequestId {0}}" Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding RequestId, Converter={StaticResource StringToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Settings">
                    <views:SettingsView DataContext="{Binding SettingsViewModel}" />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
