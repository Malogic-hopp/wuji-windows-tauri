<Window x:Class="QuantifiedSelf.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:ui="clr-namespace:QuantifiedSelf.Windows.App.UI"
        xmlns:vm="clr-namespace:QuantifiedSelf.Windows.App.ViewModels"
        xmlns:views="clr-namespace:QuantifiedSelf.Windows.App.Views"
        mc:Ignorable="d"
        ui:AdaptiveLayout.IsEnabled="True"
        Title="WUJI"
        Width="1480"
        Height="960"
        MinWidth="960"
        MinHeight="640"
        Background="{DynamicResource PageBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Page → View DataTemplate mappings (IMPORTANT: ContentControl auto-selects template by ViewModel type) -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:TodayView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimelinePageViewModel}">
            <views:TimelineView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InsightsViewModel}">
            <views:InsightsView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrendsPageViewModel}">
            <views:TrendsView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrivacyPageViewModel}">
            <views:PrivacyView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView DataContext="{Binding}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MainWindowViewModel}">
            <views:DiagnosticsView DataContext="{Binding}" />
        </DataTemplate>

        <!-- Shell dimension resources -->
        <GridLength x:Key="ShellSidebarExpandedWidth">184</GridLength>
        <GridLength x:Key="ShellSidebarCompactWidth">52</GridLength>

        <!-- Top-bar local styles -->
        <Style x:Key="TopBarCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <!-- ================================================================
         Main Shell Layout: Sidebar (184/52px) + Content Area
         ================================================================ -->
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             LEFT SIDEBAR
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ShellSidebarBorderStyle}">
                    <Setter Property="Width" Value="184" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ui:AdaptiveLayout.Mode)}"
                                     Value="Compact">
                            <Setter Property="Width" Value="52" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="WUJI"
                               Style="{StaticResource DisplayLargeStyle}"
                               Foreground="{DynamicResource ShellTextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="BrandSubtitle"
                               Text="你的时间线、洞察和趋势中枢"
                               Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ShellSubtitleStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Compact">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="1" Margin="0,16,0,12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Primary nav section label -->
                        <TextBlock x:Name="PrimaryLabel"
                                   Text="核心">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ShellSectionLabelStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Compact">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding PrimaryNavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Key}"
                                            Style="{StaticResource NavButtonStyle}"
                                            ToolTip="{Binding Title}"
                                            AutomationProperties.Name="{Binding Title}">
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Value="Compact">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource ShellTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyLargeStyle}">
                                                        <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Value="Compact">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource ShellMutedTextBrush}"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                                        <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                        <Setter Property="Margin" Value="0,3,0,0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Value="Compact">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Secondary nav section label -->
                        <TextBlock x:Name="SecondaryLabel"
                                   Text="系统">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ShellSectionLabelStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Compact">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding SecondaryNavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Key}"
                                            Style="{StaticResource NavButtonStyle}"
                                            ToolTip="{Binding Title}"
                                            AutomationProperties.Name="{Binding Title}">
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Value="Compact">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource ShellTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyLargeStyle}">
                                                        <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Value="Compact">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource ShellMutedTextBrush}"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                                        <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                        <Setter Property="Margin" Value="0,3,0,0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Value="Compact">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Trust footer -->
                <Border Grid.Row="2"
                        Style="{StaticResource ShellFooterBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="TrustFull"
                                   Text="数据只保存在本机"
                                   Foreground="{DynamicResource ShellTextBrush}"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Compact">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="TrustCompact"
                                   Text="本机"
                                   Foreground="{DynamicResource ShellTextBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   ToolTip="数据只保存在本机"
                                   AutomationProperties.Name="数据只保存在本机">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Compact">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             RIGHT: Top Bar + Content Area
             ════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Margin="14,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Page Bar -->
            <Border Grid.Row="0"
                    Style="{StaticResource TopBarBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Page title + subtitle -->
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   Style="{StaticResource DisplayLargeStyle}" />
                        <TextBlock Text="{Binding CurrentPageSubtitle}"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Style="{StaticResource BodySmallStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Agent status pill + actions -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentDateText}"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionStyle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <!-- Agent status pill (left-click Popup, right-click ContextMenu) -->
                            <Button x:Name="AgentStatusButton"
                                    Style="{StaticResource AgentStatusButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="AgentStatusButton_Click"
                                    ToolTip="Agent 状态与控制"
                                    AutomationProperties.Name="Agent 状态">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="刷新状态"
                                                  Command="{Binding RefreshCommand}" />
                                        <Separator />
                                        <MenuItem Header="暂停记录"
                                                  Command="{Binding PauseCollectionCommand}" />
                                        <MenuItem Header="恢复记录"
                                                  Command="{Binding ResumeCollectionCommand}" />
                                        <Separator />
                                        <MenuItem Header="打开设置"
                                                  Command="{Binding OpenSettingsCommand}" />
                                        <MenuItem Header="运行诊断"
                                                  Command="{Binding OpenDiagnosticsCommand}" />
                                        <Separator />
                                        <MenuItem Header="停止后台服务"
                                                  Command="{Binding StopAgentCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                             Fill="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding AgentStatusText}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Style="{StaticResource BodySmallStyle}" />
                                    <TextBlock Text=" ▾"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Style="{StaticResource MicroStyle}"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0" />
                                </StackPanel>
                            </Button>

                            <!-- Primary action button -->
                            <Button Content="{Binding PrimaryAgentActionText}"
                                    Command="{Binding PrimaryAgentActionCommand}"
                                    Style="{StaticResource TopBarCompactButtonStyle}" />

                            <!-- Agent status Popup (left-click / Enter / Space) -->
                            <Popup x:Name="AgentStatusPopup"
                                   PlacementTarget="{Binding ElementName=AgentStatusButton}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CardRadius}"
                                        Padding="{StaticResource CardPadding}"
                                        MinWidth="220"
                                        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AgentStatusText}"
                                                   FontWeight="SemiBold"
                                                   Style="{StaticResource BodyStyle}"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10" />
                                        <Separator Margin="0,0,0,8" />
                                        <Button Content="{Binding PrimaryAgentActionText}"
                                                Command="{Binding PrimaryAgentActionCommand}"
                                                Style="{StaticResource {x:Type Button}}"
                                                Margin="0,0,0,6" />
                                        <Button Content="查看运行状态"
                                                Command="{Binding OpenDiagnosticsCommand}"
                                                Style="{StaticResource GhostButtonStyle}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page Content Area -->
            <Border Grid.Row="1"
                    Style="{StaticResource ContentAreaBorderStyle}"
                    Margin="0,14,0,0">
                <ContentControl Content="{Binding CurrentPageContent}" />
            </Border>
        </Grid>
    </Grid>
</Window>
