<UserControl x:Class="QuantifiedSelf.Windows.App.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:ui="clr-namespace:QuantifiedSelf.Windows.App.UI"
             xmlns:views="clr-namespace:QuantifiedSelf.Windows.App.Views"
             xmlns:converters="clr-namespace:QuantifiedSelf.Windows.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1080"
             Background="Transparent">
    <UserControl.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Row 0: Metric Strip -->
                <RowDefinition Height="Auto" />  <!-- Row 1: Today Summary -->
                <RowDefinition Height="Auto" />  <!-- Row 2: Heatmap -->
                <RowDefinition Height="Auto" />  <!-- Row 3: Bottom Overview -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════
                 ROW 0: METRIC STRIP — 4 real metrics
                 ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="{StaticResource CardPadding}"
                    Margin="0,0,0,20">
                <UniformGrid>
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Columns" Value="4" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                    <Setter Property="Columns" Value="2" />
                                    <Setter Property="Rows" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>

                    <!-- 1: 活跃时长 -->
                    <StackPanel Margin="8">
                        <TextBlock Text="活跃时长" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding TotalActiveText}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                        <TextBlock Text="今日活跃状态累计"
                                   Style="{StaticResource MetricTrendStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <!-- 2: 记录时长 -->
                    <StackPanel Margin="8">
                        <TextBlock Text="记录时长" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding TotalDurationText}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                        <TextBlock Text="包括活跃与空闲"
                                   Style="{StaticResource MetricTrendStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <!-- 3: 使用应用 -->
                    <StackPanel Margin="8">
                        <TextBlock Text="使用应用" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding AppCountText}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                        <TextBlock Text="今日前台应用"
                                   Style="{StaticResource MetricTrendStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <!-- 4: 应用会话 -->
                    <StackPanel Margin="8">
                        <TextBlock Text="应用会话" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding SessionCountText}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                        <TextBlock Text="自动聚合的应用使用时段"
                                   Style="{StaticResource MetricTrendStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- ═══════════════════════════════════════════════════
                 ROW 4: TODAY SUMMARY — single panel, no nested cards
                 Replaces old hourly bar chart + nested insight card
                 ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="{StaticResource CardPadding}"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="今日摘要" Style="{StaticResource TitleSmallStyle}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SummaryText}"
                               Style="{StaticResource BodyLargeStyle}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource BodySmallStyle}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <!-- Capability notice -->
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="{StaticResource ControlRadius}" Padding="{StaticResource CompactInsetPadding}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="上下文分析（任务识别、专注检测、工作块划分）将在后续版本中提供。当前摘要基于应用会话和采样记录，不表示任务、上下文或心理状态。"
                                       Style="{StaticResource MicroStyle}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="应用会话时间线请在「时间线」页面查看。"
                                       Style="{StaticResource MicroStyle}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════
                 ROW 6: ACTIVITY HEATMAP
                 ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="{StaticResource CardPadding}"
                    Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="活动热力图 · 最近 7 天" Style="{StaticResource TitleSmallStyle}" />
                            <TextBlock Text="每格为 1 小时的活跃时长。颜色深浅只表示活动时长，不代表专注度。数据基于应用会话聚合。"
                                       Style="{StaticResource BodySmallStyle}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <!-- Legend -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Border Width="14" Height="14" CornerRadius="{StaticResource CellRadius}"
                                    Background="{DynamicResource Heatmap0Brush}" Margin="0,0,2,0" />
                            <Border Width="14" Height="14" CornerRadius="{StaticResource CellRadius}"
                                    Background="{DynamicResource Heatmap1Brush}" Margin="2,0,2,0" />
                            <Border Width="14" Height="14" CornerRadius="{StaticResource CellRadius}"
                                    Background="{DynamicResource Heatmap2Brush}" Margin="2,0,2,0" />
                            <Border Width="14" Height="14" CornerRadius="{StaticResource CellRadius}"
                                    Background="{DynamicResource Heatmap3Brush}" Margin="2,0,2,0" />
                            <Border Width="14" Height="14" CornerRadius="{StaticResource CellRadius}"
                                    Background="{DynamicResource Heatmap4Brush}" Margin="2,0,0,0" />
                            <TextBlock Text="低" Style="{StaticResource MicroStyle}"
                                       VerticalAlignment="Center" Margin="6,0,4,0" />
                            <TextBlock Text="高" Style="{StaticResource MicroStyle}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <views:AccessibleHeatmap DataContext="{Binding Heatmap}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════
                 ROW 8: BOTTOM OVERVIEW
                 Left: Top Apps by Duration
                 Right: Application Usage Distribution
                 ═══════════════════════════════════════════════════ -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Top Apps -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardRadius}"
                        Padding="{StaticResource CardPadding}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="主要使用应用" Style="{StaticResource TitleSmallStyle}" />
                        <TextBlock Text="按今日记录时长排序，不表示任务、上下文或工作时段。"
                                   Style="{StaticResource BodySmallStyle}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,12" />
                        <lvc:CartesianChart Series="{Binding TopAppsSeries}"
                                            XAxes="{Binding TopAppsXAxes}"
                                            YAxes="{Binding TopAppsYAxes}"
                                            LegendPosition="Hidden"
                                            ZoomMode="None"
                                            Height="220"
                                            Visibility="{Binding TopApps.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                        <TextBlock Text="暂无应用会话。Agent 写入数据后会出现在这里。"
                                   Style="{StaticResource BodySmallStyle}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Visibility="{Binding TopApps.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}" />
                    </StackPanel>
                </Border>

                <!-- Right: App Distribution -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardRadius}"
                        Padding="{StaticResource CardPadding}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                    <Setter Property="Margin" Value="0,20,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="应用使用分布" Style="{StaticResource TitleSmallStyle}" />
                        <TextBlock Text="按活跃时长计算的应用占比。不表示上下文或任务分布。"
                                   Style="{StaticResource BodySmallStyle}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,12" />
                        <lvc:PieChart Series="{Binding AppShareSeries}"
                                      LegendPosition="Bottom"
                                      Height="220" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════
                 EMPTY STATE (no data)
                 ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Grid.RowSpan="4"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="{StaticResource EmptyStatePadding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Empty">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="今天还没有活动数据"
                               Style="{StaticResource TitleMediumStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Agent 运行并写入数据后会显示在这里。"
                               Style="{StaticResource BodySmallStyle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.RowSpan="4" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}" Padding="{StaticResource EmptyStatePadding}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding State}" Value="Loading"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel><ProgressBar IsIndeterminate="True" Height="4" Width="180" /><TextBlock Text="正在加载今天的数据…" Style="{StaticResource BodySmallStyle}" Margin="0,10,0,0" HorizontalAlignment="Center" /></StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.RowSpan="4" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}" Padding="{StaticResource EmptyStatePadding}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel><TextBlock Text="今天的数据暂时无法加载" Style="{StaticResource TitleSmallStyle}" /><TextBlock Text="请稍后重试；页面不会显示原始异常信息。" Style="{StaticResource BodySmallStyle}" Margin="0,8,0,0" /><Button Content="重试" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" /></StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
