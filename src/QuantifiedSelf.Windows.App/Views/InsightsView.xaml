<UserControl x:Class="QuantifiedSelf.Windows.App.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="clr-namespace:QuantifiedSelf.Windows.App.UI"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1280"
             Background="Transparent">

    <Grid Margin="0,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Page Header + Date Nav -->
            <RowDefinition Height="Auto" />  <!-- Metric Strip -->
            <RowDefinition Height="*" />     <!-- Summary + Capability Notice -->
        </Grid.RowDefinitions>

        <!-- ROW 0: DATE NAVIGATION (Shell top bar shows page title) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                    <Button Content="‹" Width="32" Height="32"
                            Style="{StaticResource GhostButtonStyle}"
                            ToolTip="上一天"
                            AutomationProperties.Name="上一天"
                            Command="{Binding PreviousDayCommand}" />
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="130" Margin="4,0" />
                    <Button Content="今天" Width="48" Height="32"
                            Style="{StaticResource GhostButtonStyle}"
                            ToolTip="回到今天"
                            AutomationProperties.Name="回到今天"
                            Command="{Binding TodayCommand}"
                            Margin="4,0,0,0" />
                    <Button Content="›" Width="32" Height="32"
                            Style="{StaticResource GhostButtonStyle}"
                            ToolTip="下一天"
                            AutomationProperties.Name="下一天"
                            Command="{Binding NextDayCommand}" />
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════
             ROW 1: METRIC STRIP — honest app-session metrics
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}"
                Padding="{StaticResource CardPadding}"
                Margin="0,0,0,20">
            <UniformGrid>
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Setter Property="Columns" Value="4" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                <Setter Property="Columns" Value="2" />
                                <Setter Property="Rows" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>

                <!-- 1: 应用切换次数 -->
                <StackPanel Margin="8">
                    <TextBlock Text="应用切换" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding TaskSwitchesText}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                    <TextBlock Text="前台应用变更次数" Style="{StaticResource MetricTrendStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <!-- 2: 工具跳转 -->
                <StackPanel Margin="8">
                    <TextBlock Text="工具跳转" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding RawHopsText}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                    <TextBlock Text="窗口焦点切换次数" Style="{StaticResource MetricTrendStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <!-- 3: 活跃样本 -->
                <StackPanel Margin="8">
                    <TextBlock Text="活跃样本" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding ActiveSampleText}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                    <TextBlock Text="选定日期采样记录" Style="{StaticResource MetricTrendStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <!-- 4: 预估活跃 -->
                <StackPanel Margin="8">
                    <TextBlock Text="预估活跃" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding EstimatedActiveText}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                    <TextBlock Text="基于会话的活跃时长估算" Style="{StaticResource MetricTrendStyle}" Margin="0,4,0,0" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             ROW 2: SUMMARY + CAPABILITY NOTICE
             ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Summary card (when data exists) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="{StaticResource CardPadding}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="每日摘要" Style="{StaticResource TitleSmallStyle}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SummaryText}"
                               Style="{StaticResource BodyLargeStyle}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Capability notice -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="{StaticResource CardPadding}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="关于洞察能力" Style="{StaticResource TitleSmallStyle}" Margin="0,0,0,8" />
                    <TextBlock Text="当前洞察基于应用会话、窗口切换和活跃记录等可追溯数据生成。以下分析能力将在后续版本中提供："
                               Style="{StaticResource BodySmallStyle}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="• 上下文分类与工作块识别"
                               Style="{StaticResource BodySmallStyle}"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,2" />
                    <TextBlock Text="• 任务切换方向与中断分析"
                               Style="{StaticResource BodySmallStyle}"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,2" />
                    <TextBlock Text="• 专注时段与碎片化检测"
                               Style="{StaticResource BodySmallStyle}"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,2" />
                    <TextBlock Text="• 稳定工作模式识别"
                               Style="{StaticResource BodySmallStyle}"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />

                    <TextBlock Text="在此之前，洞察页仅展示可追溯到应用会话和采样记录的客观数据，不会使用「任务」「专注」「工作块」「碎片化」「上下文切换」等需要额外数据模型支撑的术语。"
                               Style="{StaticResource MicroStyle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════
             EMPTY STATE (no data)
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="{StaticResource EmptyStatePadding}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Empty">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="暂无洞察数据"
                           Style="{StaticResource TitleMediumStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Agent 运行并写入数据后会显示在这里。"
                           Style="{StaticResource BodySmallStyle}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             ERROR STATE
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="{StaticResource EmptyStatePadding}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Error">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="数据加载失败"
                           Style="{StaticResource TitleMediumStyle}"
                           Foreground="{DynamicResource DangerBrush}"
                           HorizontalAlignment="Center" />
                <Button Content="重试" Command="{Binding RefreshCommand}"
                        Style="{StaticResource {x:Type Button}}" Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}" Padding="{StaticResource EmptyStatePadding}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Loading"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
            </Border.Style>
            <StackPanel><ProgressBar IsIndeterminate="True" Height="4" Width="180" /><TextBlock Text="正在生成洞察…" Style="{StaticResource BodySmallStyle}" Margin="0,10,0,0" /></StackPanel>
        </Border>
    </Grid>
</UserControl>
