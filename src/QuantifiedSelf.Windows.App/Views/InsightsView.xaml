<UserControl x:Class="QuantifiedSelf.Windows.App.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:QuantifiedSelf.Windows.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#52606D" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#52606D" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="WorkBlockCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FBFD" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Date controls -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E3EBF3" BorderThickness="1"
                    CornerRadius="14" Padding="12" Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Insights" FontSize="15" FontWeight="SemiBold" Foreground="#102A43" />
                        <TextBlock Text="{Binding SelectedDateText}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="上一天" Command="{Binding PreviousDayCommand}" MinWidth="58" Padding="10,4" Margin="0,0,6,0" />
                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140" Margin="0,0,6,0" />
                        <Button Content="今天" Command="{Binding TodayCommand}" MinWidth="58" Padding="10,4" Margin="0,0,6,0" />
                        <Button Content="下一天" Command="{Binding NextDayCommand}" MinWidth="58" Padding="10,4" Margin="0,0,6,0" />
                        <Button Content="刷新" Command="{Binding RefreshCommand}" MinWidth="58" Padding="10,4" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Row 1: Stat cards -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E3EBF3" BorderThickness="1"
                    CornerRadius="14" Padding="14" Margin="0,0,0,12">
                <UniformGrid Columns="6" Rows="1">
                    <!-- Meaningful switches -->
                    <Border Background="#F8FBFD" CornerRadius="10" Padding="10,8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="任务切换" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding TaskSwitchesText}" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Raw tool hops -->
                    <Border Background="#F8FBFD" CornerRadius="10" Padding="10,8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="工具跳转" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding RawHopsText}" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Longest work block -->
                    <Border Background="#F8FBFD" CornerRadius="10" Padding="10,8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="最长工作块" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding LongestBlockText}" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Top interruption -->
                    <Border Background="#F8FBFD" CornerRadius="10" Padding="10,8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="首要中断" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding TopInterruptionText}" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Active samples -->
                    <Border Background="#F8FBFD" CornerRadius="10" Padding="10,8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="活跃样本" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding ActiveSampleText}" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Estimated active time -->
                    <Border Background="#F8FBFD" CornerRadius="10" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="预估活跃" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding EstimatedActiveText}" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Border>

            <!-- Row 2: Empty-state fallback -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E3EBF3" BorderThickness="1"
                    CornerRadius="14" Padding="18" Margin="0,0,0,12"
                    Visibility="{Binding InsightDataCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="暂无今日洞察数据。" Foreground="#52606D" TextWrapping="Wrap" FontSize="14" />
                    <TextBlock Text="Agent 运行并写入数据后会显示在这里。" Foreground="#52606D"
                               TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Opacity="0.6" />
                </StackPanel>
            </Border>

            <!-- Row 2: Main summary card (when data exists) -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E3EBF3" BorderThickness="1"
                    CornerRadius="14" Padding="18" Margin="0,0,0,12"
                    Visibility="{Binding InsightDataCount, Converter={StaticResource CountToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="今日洞察" Style="{StaticResource SectionTitleStyle}" />

                    <Border Background="#F8FBFD" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                        <TextBlock Text="{Binding SummaryText}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="#102A43" LineHeight="22" />
                    </Border>

                    <Border Background="#F0FDF4" CornerRadius="10" Padding="14"
                            Visibility="{Binding ActionText, Converter={StaticResource StringToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="💡 建议" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#166534" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ActionText}" FontSize="13" TextWrapping="Wrap"
                                       Foreground="#166534" LineHeight="20" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Row 3: Work Blocks + Interruption Sources (side by side) -->
            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Work Blocks -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E3EBF3" BorderThickness="1"
                        CornerRadius="14" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="工作块" Style="{StaticResource SectionTitleStyle}" />

                        <ItemsControl ItemsSource="{Binding WorkBlocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource WorkBlockCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Header: time + duration + focus badge -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#102A43">
                                                    <Run Text="{Binding StartLocal, StringFormat='{}{0:HH:mm}', Mode=OneWay}" />
                                                    <Run Text=" – " />
                                                    <Run Text="{Binding EndLocal, StringFormat='{}{0:HH:mm}', Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Duration.TotalMinutes, StringFormat='{}{0:F0}m', Mode=OneWay}" />
                                                </TextBlock>

                                                <!-- Focus badge -->
                                                <Border CornerRadius="999" Padding="8,2" Margin="10,0,0,0"
                                                        Visibility="{Binding IsRecognizedFocusBlock, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#DCFCE7" />
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="专注 ✓" FontSize="11" FontWeight="SemiBold" Foreground="#166534" />
                                                </Border>

                                                <Border CornerRadius="999" Padding="8,2" Margin="10,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FEF3C7" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecognizedFocusBlock}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="碎片化" FontSize="11" FontWeight="SemiBold" Foreground="#92400E" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Detail line -->
                                            <TextBlock Grid.Row="1" Margin="0,6,0,0" FontSize="12" Foreground="#52606D">
                                                <Run Text="{Binding PrimaryContext, StringFormat='{}{0} · ', Mode=OneWay}" />
                                                <Run Text="{Binding PrimaryApp, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding ContextSwitchCount, StringFormat='{}{0} 次切换', Mode=OneWay}" />
                                                <Run Text=" · 平均 " />
                                                <Run Text="{Binding AverageSwitchInterval.TotalSeconds, StringFormat='{}{0:F0}s', Mode=OneWay}" />
                                            </TextBlock>

                                            <!-- Explanation -->
                                            <TextBlock Grid.Row="2" Text="{Binding ExplanationText}"
                                                       FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Inner interruptions -->
                                            <ItemsControl Grid.Row="2"
                                                          ItemsSource="{Binding TopInterruptions}"
                                                          Margin="0,24,0,0"
                                                          Visibility="{Binding TopInterruptions.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                                                            <Run Text="  被中断: " />
                                                            <Run Text="{Binding DisplayText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Interruption Sources + Context Transitions (stacked) -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Interruption Sources -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E3EBF3" BorderThickness="1"
                            CornerRadius="14" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="中断来源" Style="{StaticResource SectionTitleStyle}" />

                            <ItemsControl ItemsSource="{Binding TopInterruptionSources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FBFD" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="13" FontWeight="SemiBold" Foreground="#102A43"
                                                           Text="{Binding AppName}" />
                                                <Border Grid.Column="1" Background="#E3EBF3" CornerRadius="999" Padding="8,2">
                                                    <TextBlock FontSize="11" Foreground="#52606D">
                                                        <Run Text="{Binding Count, Mode=OneWay}" />
                                                        <Run Text="× " />
                                                        <Run Text="{Binding Context, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Context Transitions -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#E3EBF3" BorderThickness="1"
                            CornerRadius="14" Padding="18">
                        <StackPanel>
                            <TextBlock Text="任务切换方向" Style="{StaticResource SectionTitleStyle}" />

                            <ItemsControl ItemsSource="{Binding TopContextTransitions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FBFD" CornerRadius="8" Padding="10,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="12" Foreground="#102A43"
                                                           Text="{Binding FromContext}" Width="100" />
                                                <TextBlock Grid.Column="1" Text=" → " FontSize="12" Foreground="#94A3B8" />
                                                <TextBlock Grid.Column="2" FontSize="12" Foreground="#102A43"
                                                           Text="{Binding ToContext}" Width="110" />
                                                <TextBlock Grid.Column="3" FontSize="12" Foreground="#52606D" Margin="8,0,0,0">
                                                    <Run Text="{Binding Count, Mode=OneWay}" />
                                                    <Run Text=" (" />
                                                    <Run Text="{Binding Ratio, StringFormat='{}{0:P1}', Mode=OneWay}" />
                                                    <Run Text=")" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Row 4: Status bar -->
            <Border Grid.Row="4" Background="White" BorderBrush="#E3EBF3" BorderThickness="1"
                    CornerRadius="12" Padding="10,8">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#94A3B8" />
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
