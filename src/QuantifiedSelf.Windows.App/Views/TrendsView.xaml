<UserControl x:Class="QuantifiedSelf.Windows.App.Views.TrendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:ui="clr-namespace:QuantifiedSelf.Windows.App.UI"
             xmlns:views="clr-namespace:QuantifiedSelf.Windows.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1280"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Range Selector -->
                <RowDefinition Height="Auto" />  <!-- Trend Summary -->
                <RowDefinition Height="Auto" />  <!-- Heatmap -->
                <RowDefinition Height="Auto" />  <!-- Charts: Two-Column -->
                <RowDefinition Height="Auto" />  <!-- Weekly Summary -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════
                 ROW 0: RANGE SELECTOR
                 ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="{StaticResource CardPadding}"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="时间范围"
                               Style="{StaticResource TitleSmallStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <!-- Only the implemented range is shown. Other ranges must not look actionable. -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="{StaticResource ControlRadius}"
                            Padding="{StaticResource SegmentedControlPadding}"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="7天"
                                          IsChecked="True"
                                          IsHitTestVisible="False"
                                          Focusable="False"
                                          Style="{StaticResource SegmentedControlToggleButtonStyle}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="30 天和 12 周范围将在聚合查询完成后开放"
                               Style="{StaticResource CaptionStyle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════
                 ROW 1: TREND SUMMARY
                 ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="{StaticResource CardPadding}"
                    Margin="0,0,0,16">
                <UniformGrid>
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Columns" Value="3" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                    <Setter Property="Columns" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>

                    <StackPanel Margin="8">
                        <TextBlock Text="7 天活跃" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding DashboardViewModel.WeekActiveTrendText}"
                                   Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Margin="8">
                        <TextBlock Text="昨日对比" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding DashboardViewModel.YesterdayActiveTrendText}"
                                   Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Margin="8">
                        <TextBlock Text="应用切换趋势" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding DashboardViewModel.SwitchTrendText}"
                                   Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- ═══════════════════════════════════════════════════
                 ROW 2: HEATMAP + METRIC TOGGLE
                 ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="{StaticResource CardPadding}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="活动热力图" Style="{StaticResource TitleSmallStyle}" />
                            <TextBlock Text="小时 × 7 天，观察长期节奏。颜色深浅只表示活动时长，不代表专注度。"
                                       Style="{StaticResource BodySmallStyle}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Only active duration has a real model and scale today. -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="{StaticResource ControlRadius}"
                                Padding="{StaticResource SegmentedControlPadding}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Content="有效使用"
                                              IsChecked="True"
                                              IsHitTestVisible="False"
                                              Focusable="False"
                                              Style="{StaticResource SegmentedControlToggleButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <views:AccessibleHeatmap DataContext="{Binding DashboardViewModel.Heatmap}" Margin="0,12,0,0" />
                    <Grid Margin="0,8,0,0" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="低" Style="{StaticResource CaptionStyle}" Margin="0,0,6,0" />
                        <Border Grid.Column="1" Width="18" Height="12" Background="{DynamicResource Heatmap0Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Margin="0,0,3,0" />
                        <Border Grid.Column="2" Width="18" Height="12" Background="{DynamicResource Heatmap1Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Margin="0,0,3,0" />
                        <Border Grid.Column="3" Width="18" Height="12" Background="{DynamicResource Heatmap2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Margin="0,0,3,0" />
                        <Border Grid.Column="4" Width="18" Height="12" Background="{DynamicResource Heatmap3Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Margin="0,0,3,0" />
                        <Border Grid.Column="5" Width="18" Height="12" Background="{DynamicResource Heatmap4Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" />
                        <TextBlock Grid.Column="6" Text="高" Style="{StaticResource CaptionStyle}" Margin="6,0,0,0" />
                    </Grid>
                    <TextBlock Text="稳定工作、上下文切换和外部中断尚无对应聚合数据，暂不提供切换。"
                               Style="{StaticResource CaptionStyle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════
                 ROW 3: CHARTS — Two-Column
                 ═══════════════════════════════════════════════════ -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Usage Trend Chart -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardRadius}"
                        Padding="{StaticResource CardPadding}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="使用时长趋势" Style="{StaticResource TitleSmallStyle}" />
                        <TextBlock Text="最近 7 天的有效使用时长"
                                   Style="{StaticResource BodySmallStyle}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,12" />
                        <lvc:CartesianChart Series="{Binding DashboardViewModel.ActiveTrendSeries}"
                                            XAxes="{Binding DashboardViewModel.ActiveTrendXAxes}"
                                            YAxes="{Binding DashboardViewModel.ActiveTrendYAxes}"
                                            LegendPosition="Hidden"
                                            ZoomMode="None"
                                            Height="280" />

                        <!-- Day cards -->
                        <ItemsControl ItemsSource="{Binding DashboardViewModel.TrendDays}" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            CornerRadius="{StaticResource CardRadius}"
                                            Padding="{StaticResource CompactCardPadding}"
                                            Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DayLabel}"
                                                       Style="{StaticResource BodySmallStyle}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DateLabel}"
                                                       Style="{StaticResource MicroStyle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,4,0,0" />
                                            <Border Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="{StaticResource PillRadius}"
                                                    Height="{Binding BarHeightPixels}"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,10,0,0">
                                                <TextBlock Text="{Binding ActiveText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource MicroStyle}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentDarkBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right: Stability Trend Chart -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardRadius}"
                        Padding="{StaticResource CardPadding}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                    <Setter Property="Margin" Value="0,20,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="工作稳定性" Style="{StaticResource TitleSmallStyle}" />
                        <TextBlock Text="分析引擎升级后可查看工作稳定性趋势。"
                                   Style="{StaticResource BodySmallStyle}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,12" />
                        <!-- Placeholder: stability chart coming with analysis engine upgrade -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="{StaticResource ControlRadius}"
                                Padding="{StaticResource EmptyStatePadding}"
                                Height="280">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="稳定性分析即将推出"
                                           Style="{StaticResource BodyLargeStyle}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="分析引擎升级后将提供工作稳定性趋势图表。"
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════
                 ROW 4: WEEKLY SUMMARY
                 ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="4"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="{StaticResource CardPadding}">
                <StackPanel>
                    <TextBlock Text="周度摘要" Style="{StaticResource TitleSmallStyle}" />
                    <TextBlock Text="{Binding DashboardViewModel.StatusText}"
                               Style="{StaticResource BodySmallStyle}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DashboardViewModel.GeneratedAtText, StringFormat=最后生成于 {0}}"
                               Style="{StaticResource MicroStyle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
