<UserControl x:Class="QuantifiedSelf.Windows.App.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:QuantifiedSelf.Windows.App.Views"
             xmlns:ui="clr-namespace:QuantifiedSelf.Windows.App.UI"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1280"
             Background="Transparent">

    <!-- No outer ScrollViewer: prevents DataGrid virtualization break -->
    <Grid Margin="0,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Page Header + Date Nav -->
            <RowDefinition Height="Auto" />  <!-- Metric Strip -->
            <RowDefinition Height="*" />     <!-- Primary / Secondary Content -->
        </Grid.RowDefinitions>

        <!-- ROW 0: DATE NAVIGATION (Shell top bar shows page title) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                    <Button Content="‹" Width="32" Height="32"
                            Style="{StaticResource GhostButtonStyle}"
                            ToolTip="上一天"
                            AutomationProperties.Name="上一天"
                            Command="{Binding PreviousDayCommand}" />
                    <TextBlock Text="{Binding SelectedDateText}"
                               Style="{StaticResource BodyStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0"
                               ToolTip="当前日期" />
                    <Button Content="›" Width="32" Height="32"
                            Style="{StaticResource GhostButtonStyle}"
                            ToolTip="下一天"
                            AutomationProperties.Name="下一天"
                            Command="{Binding NextDayCommand}" />
                    <Button Content="今天" Width="48" Height="32"
                            Style="{StaticResource GhostButtonStyle}"
                            ToolTip="回到今天"
                            AutomationProperties.Name="回到今天"
                            Command="{Binding TodayCommand}"
                            Margin="8,0,0,0" />
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════
             ROW 1: METRIC STRIP
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}"
                Padding="{StaticResource CardPadding}"
                Margin="0,0,0,20">
            <UniformGrid>
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Setter Property="Columns" Value="4" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                <Setter Property="Columns" Value="2" />
                                <Setter Property="Rows" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>

                <StackPanel Margin="8">
                    <TextBlock Text="记录时长" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding TotalDurationText}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                    <TextBlock Text="选定日期总时长" Style="{StaticResource MetricTrendStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="应用数量" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding AppCountText}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                    <TextBlock Text="选定日期前台应用" Style="{StaticResource MetricTrendStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="会话数量" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding SessionCountText}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                    <TextBlock Text="应用使用时段" Style="{StaticResource MetricTrendStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="采样记录" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding SampleCountText}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                    <TextBlock Text="原始活动记录" Style="{StaticResource MetricTrendStyle}" Margin="0,4,0,0" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             ROW 2: PRIMARY / SECONDARY CONTENT
             TabControl with: 时间线 | 应用汇总 | 会话明细 | 采样明细
             ═══════════════════════════════════════════════════ -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="时间线">
                <!-- Primary session timeline -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardRadius}"
                        Padding="{StaticResource CardPadding}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="应用会话时间线" Style="{StaticResource TitleSmallStyle}" Margin="0,0,0,4" />
                            <TextBlock Text="基于应用会话记录，不代表任务、上下文或工作块划分。"
                                       Style="{StaticResource BodySmallStyle}"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding TargetHourText}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Session items: ScrollViewer OK here — no DataGrid nested -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SessionTimelineItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="{StaticResource TimelineRowPadding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding StartedLocalTime, StringFormat={}{0:HH:mm}}"
                                                               Style="{StaticResource BodySmallStyle}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding EndTimeText}"
                                                               Style="{StaticResource MicroStyle}"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Style="{StaticResource BodyStyle}" />
                                                    <TextBlock Text="{Binding ProcessName}"
                                                               Style="{StaticResource MicroStyle}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ProcessName}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding TotalDurationText}"
                                                           Style="{StaticResource BodySmallStyle}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                CornerRadius="{StaticResource ControlRadius}"
                                                Padding="{StaticResource SurfaceInsetPadding}">
                                            <ItemsPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty timeline -->
                        <TextBlock Grid.Row="1"
                                   Text="选定日期没有会话记录。"
                                   Style="{StaticResource BodySmallStyle}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="应用汇总">
                <views:AppsView DataContext="{Binding AppsViewModel}" />
            </TabItem>

            <TabItem Header="会话明细">
                <views:SessionsView DataContext="{Binding SessionsViewModel}" />
            </TabItem>

            <TabItem Header="采样明细">
                <views:SamplesView DataContext="{Binding SamplesViewModel}" />
            </TabItem>
        </TabControl>

        <!-- ═══════════════════════════════════════════════════
             EMPTY STATE (no data for selected date)
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="{StaticResource EmptyStatePadding}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Empty">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="这一天还没有活动记录"
                           Style="{StaticResource TitleMediumStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="切换到其他日期或确认 Agent 正在运行。"
                           Style="{StaticResource BodySmallStyle}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             ERROR STATE
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="{StaticResource EmptyStatePadding}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Error">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="数据加载失败"
                           Style="{StaticResource TitleMediumStyle}"
                           Foreground="{DynamicResource DangerBrush}"
                           HorizontalAlignment="Center" />
                <Button Content="重试" Command="{Binding RefreshCommand}"
                        Style="{StaticResource {x:Type Button}}" Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}" Padding="{StaticResource EmptyStatePadding}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Loading"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
            </Border.Style>
            <StackPanel><ProgressBar IsIndeterminate="True" Height="4" Width="180" /><TextBlock Text="正在加载时间线…" Style="{StaticResource BodySmallStyle}" Margin="0,10,0,0" /></StackPanel>
        </Border>
    </Grid>
</UserControl>
