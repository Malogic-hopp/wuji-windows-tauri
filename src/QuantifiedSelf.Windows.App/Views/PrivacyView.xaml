<UserControl x:Class="QuantifiedSelf.Windows.App.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="clr-namespace:QuantifiedSelf.Windows.App.UI"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1280"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,4">
            <Border Style="{StaticResource ContentCardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="你的活动数据只保存在这台电脑上。" Style="{StaticResource TitleSmallStyle}" />
                    <TextBlock Text="WUJI 不需要登录，也不会上传应用名称、窗口标题或活动历史。"
                               Style="{StaticResource BodyStyle}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ContentCardStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="记录与保留" Style="{StaticResource TitleSmallStyle}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="窗口标题脱敏" Style="{StaticResource BodyStyle}" />
                                <TextBlock Text="保存前移除窗口标题中的敏感内容。" Style="{StaticResource CaptionStyle}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,12,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding MaskWindowTitles, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitchStyle}" AutomationProperties.Name="窗口标题脱敏" />
                        </Grid>

                        <Separator Margin="0,16" />
                        <TextBlock Text="数据保留周期" Style="{StaticResource BodyStyle}" />
                        <ComboBox ItemsSource="{Binding RetentionOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedRetentionDays, Mode=TwoWay}"
                                  Width="180" HorizontalAlignment="Left" Margin="0,8,0,0"
                                  AutomationProperties.Name="数据保留周期" />
                        <TextBox Text="{Binding CustomRetentionDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180" HorizontalAlignment="Left" Margin="0,8,0,0"
                                 AutomationProperties.Name="自定义保留天数">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRetentionDays}" Value="Custom">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Separator Margin="0,16" />
                        <TextBlock Text="排除的应用" Style="{StaticResource BodyStyle}" />
                        <TextBlock Text="这些进程不会写入活动记录。每行一条规则，可单独停用或删除。"
                                   Style="{StaticResource CaptionStyle}" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,8" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ExclusionRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Style="{StaticResource ToggleSwitchStyle}"
                                                  AutomationProperties.Name="启用排除规则" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="删除" Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewExcludedProcess, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="新增排除进程" />
                            <Button Grid.Column="1" Content="添加" Command="{Binding AddExclusionCommand}" Margin="8,0,0,0" />
                        </Grid>

                        <Button Content="保存隐私设置" Command="{Binding SavePrivacyCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />

                        <Expander Header="数据路径" IsExpanded="False" Margin="0,16,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding DataPathText}" Style="{StaticResource BodySmallStyle}" TextWrapping="Wrap" />
                                <CheckBox Content="显示完整路径" IsChecked="{Binding IsFullPathVisible, Mode=TwoWay}" Margin="0,8,0,0" />
                                <Button Content="打开数据位置" Command="{Binding OpenDataFolderCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ContentCardStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(ui:AdaptiveLayout.Mode), RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                    <Setter Property="Margin" Value="0,20,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="数据操作" Style="{StaticResource TitleSmallStyle}" />
                        <TextBlock Text="导出和清空都需要再次确认；所有操作仅在本机执行。"
                                   Style="{StaticResource BodySmallStyle}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />

                        <Separator Margin="0,16" />
                        <TextBlock Text="导出本地数据" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExportStatusText}" Style="{StaticResource CaptionStyle}"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Button Content="导出数据" Command="{Binding BeginExportCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <Border Background="{DynamicResource SurfaceAltBrush}" Padding="{StaticResource SurfaceInsetPadding}" Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExportConfirming}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="导出的压缩包包含活动数据库和配置，可能含敏感信息。确定继续吗？"
                                           Style="{StaticResource BodySmallStyle}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="确认导出" Command="{Binding ConfirmExportCommand}" />
                                    <Button Content="取消" Command="{Binding CancelExportCommand}" Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,16" />
                        <TextBlock Text="清理过期数据" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PruneDataStatusText}" Style="{StaticResource CaptionStyle}"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Button Content="执行清理" Command="{Binding PruneDataCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" />

                        <Separator Margin="0,16" />
                        <TextBlock Text="清空全部历史" Style="{StaticResource BodyStyle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="{Binding ClearHistoryStatusText}" Style="{StaticResource CaptionStyle}"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Button Content="清空历史" Command="{Binding ClearHistoryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClearHistoryConfirming}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="输入 CLEAR 后确认。此操作不可撤销。" Style="{StaticResource BodySmallStyle}" />
                            <TextBox Text="{Binding ClearHistoryConfirmationInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="清空历史确认文字" Margin="0,6,0,0" />
                            <Button Content="确认清空" Command="{Binding ConfirmClearHistoryCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding LastMaintenanceStatusText}" Style="{StaticResource CaptionStyle}"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,16,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
